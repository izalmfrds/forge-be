DATABASE_URL="postgresql://USER:PASSWORD@HOST/forge?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/forge?sslmode=require"
JWT_SECRET="generate-a-long-random-secret"
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000,https://your-forge-fe.vercel.app"
AUTH_DISABLED=false
DEV_USER_ID="dev-user"
DEV_USER_EMAIL="dev@forge.local"
JSON_BODY_LIMIT="2mb"
AI_RATE_LIMIT_PER_MINUTE=20
AI_FALLBACK_MODE=true
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT_MS=45000
ALLOW_CLIENT_MODEL_OVERRIDE=true
GEMINI_ALLOWED_MODELS="gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash"

SEED_USER_EMAIL="demo@forge.local"
SEED_USER_PASSWORD="forge-demo-123"
